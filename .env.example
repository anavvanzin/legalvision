# Optional API keys for higher rate limits on public scientific connectors
# OPENALEX_API_KEY=
# USER_EMAIL=scientist@example.com

# Public static build. Only the exact value true enables it.
# VITE_PUBLIC_DEMO=true

# Model routes remain disabled unless both this exact flag and authentication are present.
# ALLOW_MODEL_EXECUTION=true

# Cloud SQL Runtime & Schema Management Variables
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
